{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EC2InstanceLifecycleByTag",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:TerminateInstances",
        "ec2:DescribeInstances"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          %{ for tag-key, tag-value in tag-map ~}
          "ec2:ResourceTag/${tag-key}": "${tag-value}"%{ if length(tag-map) > (index(keys(tag-map), tag-key) + 1) },%{ endif }
%{ endfor ~}
        }
      }
    },
    {
      "Sid": "EC2DescribeReadOnly",
      "Effect": "Allow",
      "Action": ["ec2:Describe*"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          %{ for tag-key, tag-value in tag-map ~}
          "ec2:ResourceTag/${tag-key}": "${tag-value}"%{ if length(tag-map) > (index(keys(tag-map), tag-key) + 1) },%{ endif }
%{ endfor ~}
        }
      }
    }
  ]
}
